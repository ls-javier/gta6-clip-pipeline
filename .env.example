# --- OpenShorts (CPU mode) ---
GEMINI_API_KEY=
X264_PRESET=veryfast
FFMPEG_ENCODER=x264
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Optional OpenAI-compatible LLM for moment picking (>=16384 ctx, 7-8B+)
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# --- Publishing backend: hybrid (default) | upload_post | native
# hybrid = TikTok via the native inbox-draft uploader (free; you tap Post in the app) unless TIKTOK_ROUTE=upload_post;
#          YouTube/Instagram via Upload-Post until its monthly allowance is used, then via the native APIs below.
PUBLISH_BACKEND=hybrid
UPLOAD_POST_MONTHLY_LIMIT=10
# native (default, free inbox drafts) | upload_post (needs Basic plan)
TIKTOK_ROUTE=native
# Count TikTok uploads against the monthly allowance? (false: Basic plan is unlimited)
UPLOAD_POST_COUNT_TIKTOK=false

# --- Upload-Post ---
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# --- Native: YouTube Data API v3 (OAuth client, app set to "In Production" so the refresh token is permanent) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Native: Instagram (facebook_login = local MP4 upload; instagram_login needs a public URL, unsupported here) ---
IG_AUTH_MODE=facebook_login
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Native TikTok Inbox uploader (default TikTok route). Seeds pipeline.db on first run; DB is the source of truth afterwards ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# https URL registered under Login Kit -> Redirect URI (e.g. the GitHub Pages callback.html)
TIKTOK_REDIRECT_URI=
TIKTOK_OPEN_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook signing (openssl rand -hex 32) ---
HMAC_SECRET=

# --- n8n ---
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
GENERIC_TIMEZONE=Europe/Madrid

# --- Host ---
# gid of the 'render' group owning /dev/dri/renderD128 (stat -c %g /dev/dri/renderD128)
RENDER_GID=

# --- Audio scrub: strict (voice only) | balanced (voice + game SFX/ambience, some music remnants) ---
SANITIZER_MODE=balanced

# --- Publishing safety ---
# true  = dry run: YouTube private (+TikTok SELF_ONLY), Instagram skipped (cannot be private)
# false = LIVE public posting to every connected platform
PUBLISH_DRY_RUN=true
# Randomized wait before publishing (seconds). Lower only for testing.
JITTER_MIN_SECONDS=900
JITTER_MAX_SECONDS=2700

# --- Spike detection (spec default: ratio 3.0, min count 10) ---
SPIKE_RATIO=2.5
SPIKE_MIN_COUNT=8

# --- Twitch Helix (free app: https://dev.twitch.tv/console/apps, category "Other", client type Confidential) ---
# Only needed to rank 'gta6_only' streamers by viewers and check they are playing GTA VI.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
MAX_GTA6_GROUP=2

# --- Laughter trigger: clip also when chat laughs (jajaja / LUL / 😂) even without a volume spike ---
LAUGH_TRIGGER=1
LAUGH_MIN_MSGS=6          # laughing messages within one 10 s bin
LAUGH_MIN_FRACTION=0.3    # ...and at least this share of that bin's messages
